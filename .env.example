# Copy to .env or run scripts/bootstrap.py. Never commit filled secrets.
# Choose the backend that issued your key: vertex_express or developer.
GEMINI_BACKEND=vertex_express
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_ENABLED=false
LLM_GLOBAL_CONCURRENCY=2
LLM_TENANT_CONCURRENCY=1
LLM_REQUESTS_PER_MINUTE=5
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_TOOL_STEPS=8
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

APP_ENV=local
APP_ORIGIN=http://localhost:8185
APP_PORT=8185
# Optional social sign-in. Register OAuth applications using docs/identity-and-https.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional public HTTPS (compose.caddy.yaml); leave blank for local HTTP.
PUBLIC_DOMAIN=
ACME_EMAIL=
# Set only when the frontend is hosted separately (for example on Vercel).
FRONTEND_ORIGIN=
RETENTION_DAYS=30
AUDIT_JOBS_PER_MINUTE=60
POSTGRES_DB=prooflane
COMPOSE_PROJECT_NAME=prooflane
APP_DB_USER=prooflane_app
WORKER_DB_USER=prooflane_worker
POSTGRES_USER=postgres
S3_BUCKET=prooflane
S3_REGION=us-east-1
OIDC_CLIENT_ID=prooflane-web
OIDC_REALM=prooflane

# Generated once by bootstrap; preserve across container recreation.
APP_SECRET_KEY=
DATA_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OIDC_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=
LOCAL_ADMIN_PASSWORD=
LOCAL_AUDITOR_PASSWORD=
LOCAL_OTHER_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local recovery lease; heartbeat is every 15 seconds.
JOB_LEASE_SECONDS=60
