# Copy to .env or run scripts/bootstrap.py. Never commit filled secrets.
# Choose the backend that issued your key: vertex_express or developer.
GEMINI_BACKEND=vertex_express
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_ENABLED=false
LLM_GLOBAL_CONCURRENCY=2
LLM_TENANT_CONCURRENCY=1
LLM_REQUESTS_PER_MINUTE=5
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MAX_TOOL_STEPS=8
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096

APP_ENV=local
APP_ORIGIN=http://localhost:8185
APP_PORT=8185
RETENTION_DAYS=30
AUDIT_JOBS_PER_MINUTE=60
POSTGRES_DB=sih26155
POSTGRES_USER=postgres
S3_BUCKET=sih26155
S3_REGION=us-east-1
OIDC_CLIENT_ID=sih26155-web

# Generated once by bootstrap; preserve across container recreation.
APP_SECRET_KEY=
DATA_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OIDC_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=
LOCAL_ADMIN_PASSWORD=
LOCAL_AUDITOR_PASSWORD=
LOCAL_OTHER_PASSWORD=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local recovery lease; heartbeat is every 15 seconds.
JOB_LEASE_SECONDS=60
